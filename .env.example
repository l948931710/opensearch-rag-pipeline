RAG_SIMULATE=false
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO

# Gemini API 配置
RAG_GEMINI_API_KEY=your_gemini_api_key_here
RAG_EMBEDDING_DIMENSION=1024

# OSS 配置 (不再被 OCR 强制依赖)
RAG_OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
RAG_OSS_ACCESS_KEY_ID=your_oss_ak_here
RAG_OSS_ACCESS_KEY_SECRET=your_oss_sk_here
RAG_OSS_BUCKET_NAME=your_bucket_name

# RDS MySQL 配置
RAG_RDS_HOST=localhost
RAG_RDS_PORT=3306
RAG_RDS_USER=root
RAG_RDS_PASSWORD=your_password
RAG_RDS_DATABASE=fuling_knowledge

# OpenSearch 配置
RAG_OPENSEARCH_HOST=localhost
RAG_OPENSEARCH_PORT=9200
RAG_OPENSEARCH_USER=admin
RAG_OPENSEARCH_PASSWORD=admin_password
RAG_OPENSEARCH_INDEX=fuling_knowledge_v1
RAG_OPENSEARCH_USE_SSL=false
RAG_OPENSEARCH_VERIFY_CERTS=false

# DashScope / 阿里云百炼 API 配置
RAG_DASHSCOPE_API_KEY=your_dashscope_api_key_here
RAG_LLM_MODEL=qwen3.7-plus
RAG_EMBEDDING_MODEL=text-embedding-v4

# OpenSearch 向量检索版 (HA3 Engine) 配置
RAG_HA3_ENDPOINT=ha-cn-xxx.ha.aliyuncs.com
RAG_HA3_INSTANCE_ID=ha-cn-xxx
RAG_HA3_USER=your_ha3_user
RAG_HA3_PASSWORD=your_ha3_password
RAG_HA3_TABLE_NAME=fuling_kb_chunks

# RAG 问答 API 配置（旧版示例误写成 RAG_RAG_* 双前缀，那些名字从未生效）
RAG_TOP_K=7
RAG_MAX_CONTEXT_CHARS=6000
RAG_API_PORT=8000
RAG_MAX_HISTORY_TURNS=10

# 钉钉互动卡片配置
DINGTALK_CLIENT_ID=your_app_key
DINGTALK_CLIENT_SECRET=your_app_secret
DINGTALK_CARD_TEMPLATE_ID=your_card_template_id
DINGTALK_CARD_CALLBACK_ROUTE_KEY=rag_feedback_callback

# 钉钉 Stream 模式（出站 WSS 收机器人消息/卡片回调，免公网回调端点）。
# ⚠️ 只在生产 SAE 上开启；本地对生产应用开启会"分担"走生产用户的消息
# （Stream 是连接分担模型，同 clientId 的所有在线连接共同消费推送）。
# DINGTALK_STREAM_MODE=true

# ── 钉钉主链并发闸（M2；2026-08-06 补文档：这两个开关此前**只存在于代码里**）──────
# 默认形态 = 每条消息裸起一个 daemon 线程、且不过 admission（dingtalk_bot.py:1842）：
# 认证用户的突发请求可以耗尽线程/内存/CPU，并**绕过全局 LLM 成本限制**。
# 代码注释 dingtalk_bot.py:1703-1708 自陈该缺陷；这里补上暴露，免得运维根本不知道有这两个旋钮。
# ⚠️ 生产翻默认前先在 staging 打开观察（Sam 2026-08-06 拍板）：采集队列深度、拒绝率、P95，
#    再定 worker 数——钉钉是主入口，闸设窄了会直接给用户「忙」话术终答。
# RAG_DT_MAX_WORKERS=0          # >0 → BoundedSemaphore 封顶在飞 RAG 线程；0=不限（当前默认）
# RAG_DT_ADMISSION_ENABLE=false # true → claim 后 spawn 前过 LIMITER.admit_ask（当前默认关）

# ══ OBS-4 运维告警出口（RAG_OPS_ALERT_WEBHOOK）══════════════════════
# 🔴 **未配 = 所有运维告警静默**。alerting.py 在未配时只 logger（critical 升 error）+ 计入
# `suppressed_stats()`，绝不抛错也绝不阻断调用方——所以"没收到告警"和"没有问题"长得一模一样。
# 消费方：ops_monitor（RDS↔HA3 / OSS↔RDS 对账漂移）、rate_limiter（全局日熔断触顶）、
#        serving_pools（检索子线程池饱和）、pipeline_nodes（摄取异常）、qa_rollup。
#
# 取值：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义 → 安全设置勾**加签**。
#   RAG_OPS_ALERT_WEBHOOK = 完整 webhook URL（含 ?access_token=…）
#   RAG_OPS_ALERT_SECRET  = 加签密钥（SEC 开头）
# ⚠️ SSRF 白名单（alerting._webhook_allowed）：只收 https + *.dingtalk.com；
#    自建告警网关用 RAG_OPS_ALERT_WEBHOOK_ALLOW=host1,host2 追加域名。
# 🔴 **绝不要写进 `deploy/com.fuling.ops-monitor.plist`** —— 那个文件是**入库**的，
#    而本仓是 PUBLIC 仓。放 `.env`（已 gitignore，与 RAG_DASHSCOPE_API_KEY 同处）。
# ⚠️ `.env` 只覆盖**本机**进程（launchd 的 ops_monitor / 本地跑的脚本）。
#    SAE serving 进程（rate_limiter 触顶、serving_pools 饱和）要在**平台环境变量**里另配，
#    随下次发镜像生效。两处是分开的，配一处不等于都通。
# RAG_OPS_ALERT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# RAG_OPS_ALERT_SECRET=SECxxx
# RAG_OPS_ALERT_WEBHOOK_ALLOW=

# ══ 环境分工与守卫（docs/environment_design.md）══════════════════════
# 六层环境：SIM(空) / local / local_ab_* / staging / prod_ro(test 为弃用别名) / 生产(平台注入，不设 RAG_ENV)
# RAG_ENVIRONMENT 是安全等级（development/staging/production），与 RAG_ENV 正交。

# PROD-RO 只读会话声明（.env.prod_ro 内置；写路径一律被 env_guard 拦截）
# RAG_READONLY=true

# 守卫豁免（确知风险时显式声明，值必须精确匹配）：
# RAG_ALLOW_REMOTE_DB=read_only_ack        # 非生产标签连远程/生产 RDS
# RAG_ALLOW_REMOTE_SEARCH=read_only_ack    # 非生产标签连生产 HA3/OpenSearch
# RAG_DESTRUCTIVE_PROD_ACK=<op>:<YYYY-MM-DD>  # 非生产环境对生产目标的破坏性写，当日有效
# RAG_ALLOW_SHELL_OVERRIDE=VAR1,VAR2       # overlay file-wins 的单变量逃生口

# STAGING 专属（.env.staging；加载期强校验 _stg/-staging 后缀）
# RAG_RDS_OPERATION_DATABASE=fuling_operation_stg

# ══ Stage-3 推送后 HA3 物理存在性校验 + 有界补推（DAG-3 节点 04b）═════════
# HA3 偶发静默丢档（push failed=0 + RDS INDEXED，但 HA3 实际不存在）。开启后，停用旧版本前
# 重新读 HA3 确认本批 chunk 真实存在，对确认丢失的有界补推；补救失败/无法确认则中断防止丢失。
# 已毕业为默认开启（opt-out）：controlled validation 通过后翻正，code 默认即 true（pipeline_nodes.py:6958）。
# 显式设 0/false/no/off 才关闭——下行为临时停用示例，非"取消注释才启用"。
# RAG_STAGE3_PARITY_VERIFY=false           # 默认 true；仅在需临时停用 presence 校验时设 false
# RAG_STAGE3_PARITY_SETTLE_SEC=30          # 校验前/补推后 settle，吸收实时索引最终一致性滞后（人工运维曾见 ~120s，point-read 收敛更快）
# RAG_STAGE3_PARITY_MAX_RETRIES=2          # 确认丢失的有界补推次数上限
# RAG_STAGE3_PARITY_POINTREAD_ALL_MAX=200  # 批 chunk 数 ≤ 此值则全量 point-read（跳过不确定的 id-range 枚举）
# RAG_STAGE3_PARITY_DRIFT=true             # 内容漂移子检查：PK 在但 chunk_text_store 与内存 chunk_text
#                                          # 不一致 → 补推 + 重算 hash 确认 → 仍不一致写 PARITY_DRIFT 阻断停用。
#                                          # 依附 RAG_STAGE3_PARITY_VERIFY（不会单独生效）；presence 校验
#                                          # 充分验证后再开。大批模式下仅覆盖被 point-read 的 chunk。

# ══ 首次入库 chunk-爆炸防线（DAG-2 node_chunk_documents）═══════════════════
# 单元格化 xlsx 等可产出上万 table_chunk 垃圾块。开启后超阈值的文档按 mode 处理：
# warn=仅告警仍入库；quarantine=丢弃本轮 chunks + 标记隔离（旧版本继续服务）。默认关闭。
# RAG_CHUNK_EXPLOSION_GATE=true
# RAG_CHUNK_EXPLOSION_MODE=warn            # warn | quarantine（默认 warn）
# RAG_CHUNK_EXPLOSION_MAX=2000             # 单文档 chunk 数上限（>此值触发）
# RAG_CHUNK_EXPLOSION_DEGENERATE_MIN=200   # 退化型判定的最小 chunk 数
# RAG_CHUNK_EXPLOSION_DOMINANT_FRAC=0.95   # 单一 table_chunk 类型占比阈值（退化型）

# ══ 图像 OCR 文本 PII 检测（DAG-2 node_detect_sensitive / node_redact_or_quarantine）══
# base text 扫不到截图/嵌图里的电话/身份证/密钥（CE38C5 等）。开启后对 asset['ocr_text']（不含
# visual_summary）跑实体+关键词检测：high→整文档隔离，medium→就地脱敏 ocr_text。默认关闭。
# ⚠️ 启用前须用真实 CE38C5 OCR 样本验证物料编码 FP allow-list；脱敏仅本轮内存生效，不回写
# canonical OSS，受影响文档后续重切仍需本 flag 持续开启。
# RAG_IMAGE_OCR_PII=true

# ══ 跨文档内容去重（DAG-1 node_build_canonical）═══════════════════════════
# exact-hash 捕获 intra-doc gate 漏掉的 dup-of-public / 跨部门精确副本。默认 WARN-and-process；
# 仅当存在"可见性完整覆盖新文档受众"的 active incumbent 时才 SKIP（避免 ACL 静默降级）。默认关闭。
# ⚠️ 启用前提：先应用 schema/005_cross_doc_dedup_index.sql（idx_canonical_sha256，否则 Stage-1
# 热路径全表扫），并按需回填 canonical_sha256 提升命中率（均为 gated prod write）。
# RAG_DEDUP_CROSS_DOC=true

# ══ 恢复/续跑只读报告（dataworks_orchestrator --resume）═══════════════════
# 排空前打印一份只读恢复报告：按当前 RDS 状态显示各 stage 待处理 / 在途锁 / >2h 失效锁
# （stage 3 另含 HA3 物理孤儿估计）。排空本身仍是 unchanged run_stage_drained（不新建版本、
# 不重置已完成、绝不绕过 04b）。也可独立运行：python -m opensearch_pipeline.ingestion_resume --stage N
# RAG_INGEST_RESUME=true

# ══ 大文件摄取五道闸（2026-08-05 起支持单文件 300MB，五个数**联动**）══════
# 改任意一个都要复核其余四个 —— 漏一道的症状是「传得上去、却静默不完整」，比报错难查。
# ① 自助上传单文件上限（MB）。默认 300。前端兜底常量 console-app/src/lib/kb.ts 须同步。
# RAG_MAX_UPLOAD_MB=300
# ② 摄取下载闸（字节）。默认 400MB，**必须严格大于 ①**；否则文件传完即被 HEAD 拒下载，
#    转 NEEDS_REVIEW，前台看不出任何异常。
# RAG_EXTRACT_MAX_BYTES=419430400
# ③ PDF 原生文本抽取页上限（pdfplumber/pypdf，本地 CPU、**零 API 成本**）；默认 1000
#    （20 →200→1000）。**这是"大文档"的真瓶颈**：超限文档照常入库、只索引前 N 页，
#    带 [TRUNCATED] 留痕走 NEEDS_REVIEW，但不报错。治理看板截断判据同源此值。
# RAG_PDF_NATIVE_MAX_PAGES=1000
# ④ PDF 嵌入图片挖掘页上限；默认 100（20→100）。挖掘本地免费，但每张产出图进 OCR+VLM
#    **付费**漏斗 ⇒ 控成本压这条，别压 ③。配套：RAG_REBUILD_ENABLED / RAG_FUNNEL_MAX_IMAGES。
#    ⚠️ 2026-08-06 订正：这里原写 `RAG_REBUILD_COST_BREAKER` —— **代码里根本没有这个变量**
#    （全仓 .py 零命中），照着它配等于以为熔断器开了、其实没开。真名是 RAG_REBUILD_ENABLED
#    （config.py:999，默认 False）。
#    ⚠️ 熔断器当前**只 gate 两处**：VLM rebuilder 与图片漏斗。**page-OCR fallback 不在其内**
#    （unified_extractor.py:2745 直调 ocr_client），而 ⑤ 的页上限刚从 50 抬到 200。
# RAG_PDF_IMAGE_MAX_PAGES=100
# ⑤ OCR 页上限；默认 200（50→200）。**按页计费**，扫描件大文档直接放大账单。
# RAG_OCR_MAX_PAGES=200
# 另：签名 PUT / upload token TTL 固定 60 分钟（kb_upload.UPLOAD_TOKEN_TTL，非 env），
#     前端 XHR 超时 55 分钟须始终略小于它。

# ══ 图片 OCR PII 消费点兜底（G21：node_chunk_documents）══════════════════
# RAG_IMAGE_OCR_PII（上方）默认关且靠 stage2_node setdefault 存续——重部署丢 flag 时截图里的
# 手机号/身份证会原样进 image_refs/chunk_meta。本兜底默认【开启】：chunk 消费点对 asset ocr_text
# 命中 ENTITY_PATTERNS 者就地掩码（复用物料编码 FP allow-list），与 node 03 脱敏幂等
#（D2 2026-07-26 修复后该承诺才真正成立：此前 masked_id 的脱敏器是整词替换，
# 二次调用会把 136****5009 降级成 [标识已脱敏]；现已改为恒等）。
# 仅本地调试取证时才需关闭：
# RAG_IMAGE_OCR_PII_FAILCLOSED=false

# ══ Stage-3 毒 chunk 死信（G9：node_update_index_status / node_verify_and_repush）══
# chunk 级失败（embedding/parity）重试预算；达上限 index_status 转 DEAD（不再被 loader
# 重选，消除队头阻塞），所属文档置 chunk_status=NEEDS_REVIEW。需先应用 schema/019
# （未应用时代码自动回退旧行为）。人工修复后复位 NOT_INDEXED + index_retry_count=0 重进队。
# RAG_STAGE3_CHUNK_MAX_RETRIES=3

# ══ simhash 近重复检测（G19：DAG-1 node_build_canonical）═══════════════════
# canonical 文本 64 位 simhash 落 document_version.content_simhash（schema/020），对现役
# 其他文档 Hamming ≤ 阈值即 WARN-and-process（只告警不拦截）。默认开启；迁移未应用时静默跳过。
# RAG_NEAR_DUP_DETECT=false
# RAG_NEAR_DUP_HAMMING=3

# ══ 版本化文本归一（G20：DAG-1 node_build_canonical，哈希/持久化之前）═══════
# 保守集：去零宽 + 全角字母数字→半角（ＦＣＡ００７３→FCA0073）+ 折叠连片空行；
# 全角标点/㈠圈号刻意不动。canonical JSON 落 normalization_version 标记。默认开启。
# ⚠️ 只影响新摄取/新版本；存量 canonical 不回改。规则变更须 bump NORMALIZATION_VERSION。
# RAG_TEXT_NORMALIZE=false

# ══ 成本熔断增强（G8）══════════════════════════════════════════════════════
# 跨进程/跨实例日累计预算：RDS rag_runtime_contract 共享账本（键 vlm_cost_rmb:<北京日>），
# 0=关闭（仅进程内 run_budget）。账本不可达 fail-open。多实例并行 stage-1/2 的前置条件。
# RAG_REBUILD_DAILY_BUDGET_RMB=500
# OCR 页级缓存（键=模型+压缩渲染字节 sha256，SQLite scratch/ocr_page_cache.sqlite3）：
# 重扫/重灌同一扫描页零 API 成本。默认开启。
# RAG_OCR_PAGE_CACHE=false

# ══ 图表/流程图二次结构抽取（G17：image_funnel Funnel 3+）═══════════════════
# 仅对 VLM 分类为 process_flow/chart 的图追加一次 VLM 调用：流程图→节点/边文本，
# 数据图表→markdown 数据表+趋势结论，拼进 visual_summary 参与检索。默认关闭；
# 开启时建议同步 bump RAG_VLM_CACHE_VERSION 使旧 caption 缓存失效重抽。
# RAG_IMAGE_STRUCT_EXTRACT=true

# ══ per-batch 摄取质量指标（G22：node_validate_chunks 收尾）════════════════
# 每批落 ingest_quality_metrics（schema/021）：截断率/丢弃数/gibberish/token 分位/类型分布，
# 超阈值走 send_ops_alert（坏 PDF 批次当天可见，不等发布门 L6）。默认开启，写侧 fail-open。
# RAG_INGEST_QUALITY_METRICS=false
# RAG_INGEST_QUALITY_MIDCUT_ALERT=0.25
# RAG_INGEST_QUALITY_INVALID_ALERT=0.10

# ══ 报告1 P0 加固（2026-07-10 外审；全 flag 门控，默认 off = 现网行为不变）════════
# P0-03 强制认证：开启后 /api/search /api/ask /api/ask/stream /api/resign-images 对无/无效
#   Bearer 返回 401（hot-questions 保持公开——匿名已 fail-safe 到静态兜底）。**开启前必须确认
#   小程序已发布带 auth 的 resignImages**（钉钉 bot 走进程内直调不受影响）。建议先 staging 灰度。
# RAG_REQUIRE_AUTH=true
# P0-04 ACL fail-closed：开启后 ①current_identity 在 user_role DB **失败**时降级仅 public
#   （无在册行仍保留令牌组）②主命中 RDS 复核不可用时只投放 public。RDS 抖动期牺牲部门内容
#   可用性换安全，报告称可 P1、需业务签字。默认 off。
# RAG_ACL_FAIL_CLOSED=true

# ── 组织树（node）授权通道（schema/060 阶段 A；⚠️ 现网**已开**，2026-08-03 起）────
# 打开 = 允许用【组织节点】而不是 10 个组码来表达归属与可见范围：
#   · 上传/升版可选 owner_dept_id + visible_nodes（kb_console upload-url / kb_register）；
#   · 知识贡献可挂 category_dept_id（schema/067，2026-08-07）——关掉时提交 node 贡献
#     **直接 400 拒绝**，刻意不静默回落组码轴（Sam 裁决 E：静默回落=归属悄悄换了根轴）。
# 关掉**不回滚已存在的 node 数据**：既有 node 文档/贡献仍按 node 判定（否则它们会变成无人可管）。
# 这里默认注释 = 本地开发默认关；**生产/staging 由部署侧显式设 true，别以本文件为现网口径**
# （现网姿态一律现查 /api/kb/org-tree 的 node_acl_grant 字段）。
# RAG_NODE_ACL_GRANT=true
#
# 读路径的节点通道强制位（阶段 A 双 flag 的另一半，默认**开**）。设 false = 节点授权只写不判，
# 等于把 node 文档的可见性交还给组码残值——除非在做迁移演练，否则别关。
# RAG_NODE_ACL_ENFORCE=false

# P0-02 RDS 传输加密：配 CA 证书路径即启用 TLS（默认空=不传 ssl，现网不变）。
# RAG_RDS_SSL_CA=/path/to/ApsaraDB-CA-Chain.pem
# RAG_RDS_SSL_VERIFY_CERT=true

# ══ 知识缺口队列质量（2026-07-18）══════════════════════════════════════════
# 读出侧无效问题分层过滤（qa_session_log 审计流水不动，仅影响缺口/洞察展示）：
#   JUNK_FILTER 默认【开】——纯标点/单字/纯数字确定性垃圾不进缺口（false=逃生阀恢复现状）；
#   HIDE_INCOMPLETE 默认【开】——短且缺主体（如「然后呢」）且【毫无会话上下文】的低质量
#   缺口隐藏；有上下文（同会话有前序问答/已被追问改写）的短问题保留可认领。
#   MIN_QLEN=junk 判定的归一化最短长度（默认 2 = 仅单字算垃圾）。
# RAG_QA_GAP_JUNK_FILTER=false
# RAG_QA_GAP_HIDE_INCOMPLETE=false
# RAG_QA_GAP_MIN_QLEN=2

# ══ 多轮追问检索前改写（schema/050；默认关）════════════════════════════════
# 「那第二步呢」类指代追问在检索前用小模型改写成独立问题：检索/失败分诊用改写后
# query，生成端仍用原问题+history；落库 query_text 保真、rewritten_query 存改写结果、
# question_hash 按改写后文本（缺口按真实意图归并）。门控只对命中指代/接续词或
# 短缺主体的问题触发（「怎么请假」不调 LLM）；任何失败 fail-open 回原问题。
# RAG_FOLLOWUP_REWRITE=true
# RAG_FOLLOWUP_MAX_LEN=12          # 「短」上限（归一化字符数；也是 incomplete 判定阈值）
# RAG_FOLLOWUP_REWRITE_MODEL=qwen3.7-plus
# RAG_FOLLOWUP_REWRITE_TIMEOUT=4

# ── 图像 PII 留痕指纹密钥（方案 A，审查 P2-12）────────────────────────────
# document_sensitive_finding 里 image_scrub:* 行的 matched_text_hash。**必须是独立密钥**
# （不复用 RAG_SESSION_SIGNING_KEY / RAG_UPLOAD_SIGNING_KEY —— 一钥两用扩大泄漏半径）。
# 未配置时该列写 NULL：少一列指纹只是少了去重能力，而无盐 SHA-256 对 11 位手机号是
# 秒级枚举可回推的，等于把明文放进一张有看板查询面、默认留存 24 个月的表。
# RAG_PII_FINGERPRINT_KEY=

# ── skip-gate 是否尊重资产集新增（审查 P1-5）─────────────────────────────
# 默认【开启】。_canonical_sha256 只哈希正文，而 ROUTE_TO_VECTOR 不产 block ⇒ 选项 C 与
# RAG_PDF_STRIP_STITCH 救回的图不改变正文哈希，会被 RAG_SKIP_UNCHANGED_REINGEST 判
# SKIPPED_DUPLICATE 挡在索引之外。判据**非对称**：只有"新增"撤销 skip（破损的抽取环境
# 只会产出更少的图），"减少"绝不撤销（否则零图的新版本会去停用正在服务的旧版本）。
# RAG_SKIP_GATE_HONORS_ASSETS=false
