/* 知识库管理 · 文档列表 — 复用 Aurora-Forest 令牌（surface / text / brand 等） */
.kb-page {
  min-height: 100vh;
  padding: 16rpx 24rpx 48rpx;
}

/* ---------- 顶部操作条 ---------- */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 12rpx;
}

.topbar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

/* 管理员身份徽章行（.admin-badge 定义在 app.acss，跨页共享） */
.role-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8rpx 20rpx;
}

.role-scope {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

/* ---------- 管理范围统计条（/api/kb/stats；取数失败整条隐藏）---------- */
.stats-strip {
  display: flex;
  flex-direction: row;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: var(--sh-1);
  padding: 22rpx 8rpx;
  margin: 0 8rpx 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1px solid var(--line-2);
}

.stat-last {
  border-right: none;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.2;
}

.stat-ok {
  color: var(--success);
}

.stat-warn {
  color: var(--warn);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

/* ---------- 待我审批（kb_admin）---------- */
.appr-card {
  background: var(--surface);
  border: 1px solid var(--warn-bg);
  border-radius: 28rpx;
  box-shadow: var(--sh-1);
  margin: 0 8rpx 20rpx;
  overflow: hidden;
}

.appr-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx;
  background: var(--warn-bg);
}

.appr-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--warn);
}

.appr-count {
  margin-left: 12rpx;
  min-width: 34rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--warn);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
}

.appr-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1px solid var(--line-2);
}

.appr-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.appr-doc {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.appr-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.appr-btn {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin-left: 12rpx;
}

.appr-btn-text {
  font-size: 24rpx;
  font-weight: 500;
}

.appr-reject {
  border: 1px solid var(--danger-soft);
}

.appr-reject:active {
  background: var(--danger-bg);
}

.appr-reject-text {
  color: var(--danger);
}

.appr-approve {
  background: var(--brand-strong);
  box-shadow: var(--sh-brand);
}

.appr-approve:active {
  background: var(--brand-press);
}

.appr-approve-text {
  color: #ffffff;
}

.btn-upload {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--brand-grad);
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4px 12px rgba(21, 96, 74, 0.22);
}

.btn-upload-ico {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.btn-upload:active {
  opacity: 0.88;
}

/* ---------- 搜索条 ---------- */
.searchbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--surface);
  border-radius: 999rpx;
  box-shadow: var(--sh-1);
  padding: 10rpx 24rpx;
  margin: 0 8rpx 20rpx;
}

.search-ico {
  font-size: 28rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-1);
  height: 56rpx;
  line-height: 56rpx;
}

.search-clear {
  font-size: 26rpx;
  color: var(--text-3);
  padding: 6rpx 10rpx;
}

/* ---------- 列表 ---------- */
.list {
  display: flex;
  flex-direction: column;
}

.doc-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: var(--sh-1);
  padding: 28rpx 28rpx;
  margin-bottom: 18rpx;
}

.doc-card:active {
  background: var(--surface-2);
}

.doc-main {
  flex: 1;
  min-width: 0;
}

.doc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.35;
  word-break: break-all;
}

.doc-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.doc-tag {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--surface-2);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
}

.doc-ver {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}

.doc-date {
  font-size: 22rpx;
  color: var(--text-3);
}

.doc-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.doc-chev {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* ---------- 状态徽章 ---------- */
.badge {
  font-size: 22rpx;
  border-radius: 14rpx;
  padding: 4rpx 14rpx;
}

.badge-ok {
  color: var(--success);
  background: var(--success-bg);
}

.badge-busy {
  color: #2563eb;
  background: rgba(59, 130, 246, 0.14);
}

.badge-queue {
  color: var(--text-3);
  background: var(--surface-2);
}

.badge-warn {
  color: var(--warn);
  background: var(--warn-bg);
}

.badge-fail {
  color: var(--danger);
  background: var(--danger-bg);
}

.badge-muted {
  color: var(--text-3);
  background: var(--surface-2);
}

/* ---------- 加载/空/错误态 ---------- */
.state-wrap {
  padding: 24rpx 8rpx;
}

.state-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.state-ico {
  font-size: 64rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

.state-title {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 600;
}

.state-desc {
  font-size: 25rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

.skel-card {
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: var(--sh-1);
  padding: 28rpx;
  margin-bottom: 18rpx;
}

.skel-ln {
  height: 26rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
  margin-bottom: 16rpx;
}

.skel-ln.w70 {
  width: 70%;
}

.skel-ln.w40 {
  width: 40%;
  margin-bottom: 0;
}

.btn-retry {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 28rpx;
  background: var(--surface);
  box-shadow: var(--sh-1);
  border-radius: 999rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  color: var(--text-1);
}

.retry-ico {
  margin-right: 10rpx;
  font-size: 26rpx;
  color: var(--brand);
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 25rpx;
  color: var(--text-3);
}
