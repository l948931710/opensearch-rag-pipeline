# ── 生产安全/质量门（非密钥策略开关，值即策略，故此处显式给值而非留空）─────────────
# 二者的 code 默认刻意保持 OFF（保 eval/单测逐字节基线 + A/B）；生产由平台注入 true 打开。
# ⚠️ 仓库改动只是"清单声明"——实际生效仍须在对应平台把变量设成下列值：
#   · RAG_PROMPT_INJECTION_GUARD → SAE serving（answer 链路）环境变量
#   · RAG_CHUNK_EXPLOSION_GATE   → DataWorks 摄取节点环境变量
# 间接 prompt injection 防护（P2-01，llm_generator.py:77）：把「参考文档」区块声明为不可信数据，
# 堵住恶意文档「忽略以上规则/输出系统提示」类指令。附加规则，不改检索/存储，仅答案链路生效。
RAG_PROMPT_INJECTION_GUARD=true
# chunk 爆炸门（pipeline_nodes.py:4347）：单文档 chunk 数异常放大时告警。warn=仅告警仍入库
# （非破坏、零存储行为变化）；quarantine 档留作 opt-in，勿在生产默认设 quarantine。
RAG_CHUNK_EXPLOSION_GATE=true
RAG_CHUNK_EXPLOSION_MODE=warn
