# .env.production.template — 生产环境变量清单（仅变量名，可提交）
# ⚠️ 真值不存在于仓库：SAE 控制台「环境变量」与 DataWorks 节点配置注入。
# 迁移完成（checklist P4）后删除本地 .env.production 本体并轮换旧 AK。
# 各变量语义见 docs/environment_design.md 与 opensearch_pipeline/config.py。

RAG_ENVIRONMENT=
RAG_SIMULATE=
RAG_RDS_HOST=
RAG_RDS_PORT=
RAG_RDS_USER=
RAG_RDS_PASSWORD=
RAG_RDS_DATABASE=
RAG_HA3_ENDPOINT=
RAG_HA3_INSTANCE_ID=
RAG_HA3_USER=
RAG_HA3_PASSWORD=
RAG_HA3_TABLE_NAME=
RAG_OSS_ENDPOINT=
RAG_OSS_ACCESS_KEY_ID=
RAG_OSS_ACCESS_KEY_SECRET=
RAG_OSS_BUCKET_NAME=
RAG_SCORE_THRESHOLD_HIGH=
RAG_SCORE_THRESHOLD_MEDIUM=

# ── 路由式重排（reranker.py；SAE serving answer 链路）───────────────────────────
# 代码默认 OFF（保 eval/单测逐字节基线 + A/B）；生产开启。251 题金标集实测
# recall@1 +10.5pp、答案正确性 +0.21，无 faithfulness 回退；代价 ~+1.3s/答案 + 每问
# 一次 rerank API 调用（文本池走 qwen3-rerank，含图池走 qwen3-vl-rerank）。
# ⚠️ 仓库改动只是"清单声明"——实际生效须在 SAE 控制台把 RAG_RERANK_ENABLE 设成 true。
# ⚠️ 阈值自动切换：chunk 带 rerank_score 时 _format_context 改用 rerank 尺度阈值
#   （0.9/0.8），无需手动切；下方两值显式 pin 与代码默认一致。
# ℹ️ backlog #81：纯文本查询池里混进 1 条带图 chunk 会让整池走更慢更贵的 VL 重排；
#   若上线后 P99/百炼账单敏感，再按图片占比/意图设阈值收窄 VL 路由（非阻塞）。
RAG_RERANK_ENABLE=true
RAG_RERANK_TEXT_MODEL=qwen3-rerank
RAG_RERANK_VL_MODEL=qwen3-vl-rerank
RAG_RERANK_ROUTE_VL=true
RAG_RERANK_POOL=20
RAG_RERANK_TIMEOUT=15
RAG_RERANK_SCORE_THRESHOLD_HIGH=0.9
RAG_RERANK_SCORE_THRESHOLD_MEDIUM=0.8

# ── 生产安全/质量门（非密钥策略开关，值即策略，故此处显式给值而非留空）─────────────
# 二者的 code 默认刻意保持 OFF（保 eval/单测逐字节基线 + A/B）；生产由平台注入 true 打开。
# ⚠️ 仓库改动只是"清单声明"——实际生效仍须在对应平台把变量设成下列值：
#   · RAG_PROMPT_INJECTION_GUARD → SAE serving（answer 链路）环境变量
#   · RAG_CHUNK_EXPLOSION_GATE   → DataWorks 摄取节点环境变量
# 间接 prompt injection 防护（P2-01，llm_generator.py:77）：把「参考文档」区块声明为不可信数据，
# 堵住恶意文档「忽略以上规则/输出系统提示」类指令。附加规则，不改检索/存储，仅答案链路生效。
RAG_PROMPT_INJECTION_GUARD=true
# chunk 爆炸门（pipeline_nodes.py:4347）：单文档 chunk 数异常放大时告警。warn=仅告警仍入库
# （非破坏、零存储行为变化）；quarantine 档留作 opt-in，勿在生产默认设 quarantine。
RAG_CHUNK_EXPLOSION_GATE=true
RAG_CHUNK_EXPLOSION_MODE=warn
